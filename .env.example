# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Set it as a runtime env var / Secret Manager secret on Cloud Run.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FDC_API_KEY: USDA FoodData Central key that powers the "Database" food search
# (/api/food-search). Free — get one at https://fdc.nal.usda.gov/api-key-signup.
# Optional: if unset, the food search simply falls back to the in-bundle catalog.
# Note: DEMO_KEY works for local testing but is rate-limited per IP — set a real
# key on Cloud Run, where every user shares the server's egress IP.
FDC_API_KEY="MY_USDA_FDC_API_KEY"

# Supabase (client-side). The VITE_ prefix exposes these to the browser bundle.
# Find these in your Supabase project: Project Settings -> API.
# The publishable/anon key is safe to ship publicly — Row-Level Security protects data.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Supabase (server-side, for in-app account deletion).
# SUPABASE_URL is the same project URL as above (no VITE_ prefix — server only).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row-Level Security: keep it SECRET. Set it as
# a runtime env var (Cloud Run) and in your local .env — NEVER commit it or expose
# it to the browser. Find it in Project Settings -> API -> service_role key.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"
